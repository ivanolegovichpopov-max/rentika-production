# Скопируйте в .env и заполните реальными значениями перед запуском
# docker-compose. Файл .env НЕ должен попадать в систему контроля версий
# (см. .gitignore) — здесь только пример структуры и безопасные плейсхолдеры.

# --- Postgres ---
POSTGRES_DB=rentika
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-random-value

# Совпадает с POSTGRES_PASSWORD выше — используется миграциями (суперпользователь)
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:change-me-to-a-strong-random-value@db:5432/rentika
# Пароль здесь должен совпадать с тем, что задан в alembic-миграции для роли
# rentika_app (ALTER ROLE rentika_app PASSWORD ... — обновите после первого
# деплоя, миграция создаёт роль с временным паролем 'changeme').
DATABASE_URL=postgresql+psycopg://rentika_app:changeme@db:5432/rentika

REDIS_URL=redis://redis:6379/0

# Сгенерируйте случайную строку не короче 32 байт, например: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Домен, на котором будет открываться CRM (для CORS и cookies)
CORS_ORIGINS=["https://crm.your-domain.example"]

# Email, который при регистрации автоматически получает права суперадмина
# платформы. Оставьте пустым, если ещё не решили — тогда включите вручную
# через прямой SQL (UPDATE users SET is_platform_admin = true WHERE email = ...).
PLATFORM_ADMIN_EMAIL=

ENVIRONMENT=production

# Домен для автоматического HTTPS через Caddy (см. Caddyfile) — если не
# используете свой домен, а тестируете локально, оставьте localhost и
# закомментируйте TLS-строки в Caddyfile (см. комментарий там же).
DOMAIN=crm.your-domain.example

# Куда backend ходит за HIBP (Have I Been Pwned) для проверки паролей на
# утечки — оставьте true, если у сервера есть исходящий доступ в интернет.
PASSWORD_CHECK_HIBP=true
